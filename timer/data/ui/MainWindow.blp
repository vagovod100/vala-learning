using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  title: _("Timer");

  content: Adw.ToolbarView {
    top-bar-style: flat;

    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Timer");
      };
    }

    content: Adw.Clamp {
      hexpand: true;
      vexpand: true;
      valign: center;

      child: Box {
        orientation: vertical;
        spacing: 24;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 24;
        margin-end: 24;
        halign: center;

        // Ряд с тремя сегментами
        Box {
          orientation: horizontal;
          halign: center;
          spacing: 6;

          SpinButton hours_spin {
            halign: center;
            orientation: vertical;
            wrap: true;
            value: 0;
            climb-rate: 1;
            width-chars: 2;
            xalign: 0.5;
            numeric: true;

            adjustment: Adjustment {
                lower: 0;
                upper: 23;
                step-increment: 1;
                value: 0;
              };
          }

          Label {
            label: ":";
            css-classes: ["title-4"];
          }

          SpinButton minutes_spin {
            halign: center;
            orientation: vertical;
            wrap: true;
            value: 0;
            climb-rate: 1;
            width-chars: 2;
            xalign: 0.5;
            numeric: true;

            adjustment: Adjustment {
                lower: 0;
                upper: 59;
                step-increment: 1;
                value: 0;
              };
          }

          Label {
            label: ":";
            css-classes: ["title-4"];
          }

          SpinButton seconds_spin {
            halign: center;
            orientation: vertical;
            wrap: true;
            value: 0;
            climb-rate: 1;
            width-chars: 2;
            xalign: 0.5;
            numeric: true;

            adjustment: Adjustment {
                lower: 0;
                upper: 59;
                step-increment: 1;
                value: 0;
              };
          }
        }

        Button start_button{
          label: _("Start");

          styles [
            "suggested-action",
          ]
        }
      };
    };
  };
}
